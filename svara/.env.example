# ======================= Svara server sozlamalari =======================
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env hech qachon git'ga qo'shilmaydi (.gitignore).

# --- majburiy (production) ---
NODE_ENV=production
# @BotFather bergan token. Hech kimga bermang, kodga yozmang.
BOT_TOKEN=
# Bot username (@ siz) — taklif havolalari uchun: t.me/<BOT_USERNAME>?start=room_KOD
BOT_USERNAME=
# Mini App manzili (HTTPS). Odatda shu serverning manzili.
WEBAPP_URL=https://svara.example.com/

# --- server ---
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/svara.db
# Reverse proxy (Caddy/Nginx/Render) orqasida bo'lsa — haqiqiy IP uchun
TRUST_PROXY=1
# Frontend boshqa domenda bo'lsa (masalan GitHub Pages), vergul bilan:
CORS_ORIGINS=
# Botni server bilan birga ishga tushirish (long polling)
BOT_POLLING=1

# --- adminlar: Telegram ID lar, vergul bilan ---
ADMIN_IDS=

# --- o'yin ---
START_BALANCE=1000
BONUS_AMOUNT=500
BONUS_COOLDOWN_SEC=14400
ANTES=10,50,100,500
BUY_IN_ANTES=100
TURN_SECONDS=25
SVARA_DECISION_SECONDS=10
NEXT_HAND_SECONDS=5
RESULT_SECONDS=4
NPC_FILL_SECONDS=8
DISCONNECT_GRACE_SEC=60

# --- faqat lokal ishlab chiqish: Telegram'siz brauzerda kirish ---
# Production'da (NODE_ENV=production) baribir o'chiq bo'ladi.
DEV_AUTH=0
